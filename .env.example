# Copy these into Vercel → Project → Settings → Environment Variables.

# Site editor (/admin): the password needed to publish.
ADMIN_PASSWORD=

# Publishing commits data/content.json to this repo; Vercel then redeploys.
# A fine-grained GitHub token with "Contents: read and write" on this one repo.
GITHUB_TOKEN=
GITHUB_REPO=asheesh8/GoodHarborInsurance
GITHUB_BRANCH=main

# Contact form emails, sent with Resend (resend.com).
RESEND_API_KEY=
CONTACT_TO=office@ghrsolutions.com
CONTACT_FROM=Good Harbor website <website@goodharborinsurance.com>
